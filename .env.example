# ── Saasy Agent Configuration ──────────────────────────────────────────────

# Required: Saasy API URL
SAASY_API_URL=https://api.saasy.fr

# Required: API key with infrastructure scope + infra:metrics:write + infra:logs:write
SAASY_AGENT_KEY=fbk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required: Server ID (from Saasy dashboard)
SAASY_SERVER_ID=xxxxxxxxxxxxxxxxxxxx

# ── Collection Settings ───────────────────────────────────────────────────

# System metrics collection interval (seconds, default: 30)
COLLECT_INTERVAL=30

# Log batch flush interval (seconds, default: 10)
LOG_FLUSH_INTERVAL=10

# Heartbeat interval (seconds, default: 60)
HEARTBEAT_INTERVAL=60

# ── Docker Settings ───────────────────────────────────────────────────────

# Docker socket path (default: /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# Container names to monitor (comma-separated, empty = all)
LOG_CONTAINERS=

# ── Agent Info ────────────────────────────────────────────────────────────

# Agent hostname override (default: system hostname)
# AGENT_HOSTNAME=my-server
